# CallPilot 配置示例（与 src/agentcall/config.py 的 CONFIG_SPECS 注册表对齐）。
# 复制为 .env 后按需修改；所有「面板可编辑」项也可在网页设置面板中直接改。

# ================= Agent =================
# Agent 提供方: qwen | doubao (experimental) | openai | local
AGENT_PROVIDER=local
# 机主姓名（AI 自我介绍与通话摘要视角；默认空 = 中性称谓「机主」）
# 运营商免费客服号；留空=按 SIM 的 IMSI 自动识别（识别不到/携号转网时填这里覆盖）
CARRIER_HOTLINE=
OWNER_NAME=
# 机主手机号：AI 转告口信短信的收件号码（send_sms 的 to 填 owner 时解析成它，
# 并放行发信白名单）。留空 = AI 无法把口信短信发给机主
OWNER_PHONE=
# AI 人设称谓（默认空 = 按 AGENT_LANGUAGE 取「AI 助理」/「AI assistant」）
AGENT_PERSONA=
# 语音风格描述（如"语速稍慢、亲切自然"）；并入系统提示，qwen/openai 两链路生效。默认空
VOICE_STYLE=
# AI 通话语言: zh | en —— 决定 AI 打/接电话说什么语言、摘要用什么语言（默认 zh）
AGENT_LANGUAGE=zh
# 外呼默认任务指令（单次外呼可在页面临时覆盖）
AGENT_OUTBOUND_TASK=代表机主主动外呼，对方接起后自然说明来意，并围绕本次目的简短沟通。
# 拨号前按号码+事项生成本通场景与开场策略（默认 true；失败自动回退模板）
PROMPT_GEN_ENABLED=true
# 动态场景提示词模型：留空=按提供方默认（qwen→qwen-plus，openai→gpt-4o-mini）
PROMPT_GEN_MODEL=
# 动态场景提示词请求超时 / 接通后等待秒数（调试项，一般无需改动）
PROMPT_GEN_TIMEOUT=5.0
PROMPT_GEN_WAIT_SECONDS=3.0
# 预调教任务库：拨号前优先查本地 JSON 里的 (号码+任务) 场景；命中则跳过动态生成。
# 文件留空 = data/number_profiles.json；格式见 data/number_profiles.example.json
NUMBER_PROFILES_ENABLED=true
NUMBER_PROFILES_FILE=
# 呼叫情报库：种子/人工必备项仍硬拦截；learner 新发现先作 AI 软提示
CALL_PLAYBOOKS_ENABLED=true
CALL_PLAYBOOKS_FILE=
# 同一字段至少几通独立、明确索要且模型判为强证据的通话才硬拦截（最小 2）
CALL_PLAYBOOKS_MIN_EVIDENCE_CALLS=2
# 实体卡产品默认本地语音 + DeepSeek；Key 由使用者自行填写。
# 音频（VAD/STT/TTS）全在本机跑，只有转写文本上云。
# Mac 包内置默认语音模型；开发版先装依赖 pip install 'callpilot[local]'，再下载：
#   .venv/bin/python -m agentcall.local_models
LOCAL_LLM_MODEL=deepseek-flash
# DeepSeek 组合：PROVIDER=deepseek、MODEL=deepseek-flash；Key 与 DashScope 独立。
LOCAL_LLM_PROVIDER=deepseek
LOCAL_LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# disabled | low | high（仅 DeepSeek）
LOCAL_LLM_THINKING=disabled
LOCAL_LLM_TIMEOUT=20.0
LOCAL_MODELS_DIR=
# physical-sim owner 决定提速默认开启，发包前真机验收；显式 false 可关闭。
# 振铃期间预合成；仍遵守 opening_mode=wait，不抢 IVR。
LOCAL_FAST_OPENING=true
# 纯 TCP/TLS 建连，不发 HTTP、不产生 token；忙碌时不刷新。
LOCAL_LLM_PREWARM=true
LOCAL_LLM_PREWARM_IDLE=15.0
# 来电直接合成配置的问候；建议同时加入 LOCAL_TTS_CACHE_PHRASES，空则由 LLM 生成。
LOCAL_INBOUND_GREETING=
# 默认边说边识别：短停顿切段后立即识别，轮末再合并提交；显式 false 使用整段识别。
LOCAL_ASR_SEGMENTED=true
# 依赖分段识别和 DeepSeek；取消的请求也可能消耗 token，判停前绝不播放/执行工具。
LOCAL_SPECULATIVE_LLM=true
LOCAL_LATENCY_METRICS=true
LOCAL_ASR_SEGMENT_SILENCE=0.25
# 轮末物理静音：从最后一次语音结束起累计，含切段已等待时长，与整段模式 0.6s 判停可比。
# 默认吐段后再等约 0.35s；若轮末阈值 <= 切段阈值，启动时警告，吐段即判停。
LOCAL_TURN_SILENCE=0.6
# 可选 matcha-icefall-zh-baker（自动下载对应模型及 vocos 声码器）
# 或 kokoro-int8-multi-lang-v1_1（多说话人，需配 LOCAL_TTS_SPEAKER_ID 选择音色）
# 或旧音色 vits-piper-zh_CN-chaowen-medium-int8（切换时需同时选择对应 speaker）
# owner 10-24 已选定 aishell3 男声 #25；缺失时走现有模型下载机制。
# 该模型原始音量偏小，建议验收音量后按需设 LOCAL_TTS_PEAK=0.9（本轮不改其默认值）。
LOCAL_TTS_MODEL=vits-icefall-zh-aishell3
LOCAL_TTS_SPEAKER_ID=25
LOCAL_TTS_STREAMING=true
# | 分隔，精确匹配分句结果，含标点；启动时预合成，不输出。
LOCAL_TTS_CACHE_PHRASES=
# 判停后仍在等首轮 LLM 且未送分句时，播一次缓存短句；同通至少间隔 8 秒，0 关闭。
LOCAL_SLOW_REPLY_FILLER_SECONDS=2.5
LOCAL_SLOW_REPLY_FILLER=嗯，您稍等。
# 空=不处理；建议 0.9；增益上限 +12 dB。
LOCAL_TTS_PEAK=
# 手动应答控制（qwen only，默认 false）：保留 server VAD 转写，但由本地静默合并定时触发回复，
# 抑制对连播 IVR 的逐段抢答。设 true 启用（适合"连续念长菜单"型 IVR）。
# 真机标定（2026-07-10，6 通拨 10000）：IVR 连播段间隙 p90=2.4s——启用时建议
# MANUAL_RESPONSE_SILENCE_MS=2500 才能把连播合并成一轮；代价是真人对话每轮慢 ~2.5s，
# 故保持默认关、按场景手动开。
MANUAL_RESPONSE_CONTROL=false
# 静默超过该窗口才触发一次手动回复；连续转写会重置窗口（默认 1000ms）
MANUAL_RESPONSE_SILENCE_MS=1000
# barge-in：对端开口即打断 AI（掐生成+清未播积压），代替半双工丢上行。
# 开启前提：模组无下行→上行回采（SIM7600 CPCMREG 实测干净可开；
# Quectel UAC 路线未验证回采，保持 false 走原半双工）。
BARGE_IN_ENABLED=false
# 连续播报超过该累计等待也强制触发一次回复，避免永远插不进话（默认 8000ms）
MANUAL_RESPONSE_MAX_WAIT_MS=8000
# DTMF 文本判官：off=关闭；shadow=只旁观并记录判断，绝不自动按键。
DTMF_JUDGE_MODE=off
# 留空=按提供方自动选择（openai→gpt-4o-mini，qwen→qwen-plus）。
DTMF_JUDGE_MODEL=

# --- 通义千问 (DashScope) ---
# 必填（qwen 提供方）。留空即可：占位值会骗过启动非空校验，
# 把鉴权错误推迟到第一通电话。申请：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# 实时语音的函数调用（工具）仅 qwen3.5-omni-*-realtime 支持
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
# qwen3.5-omni 支持的音色：Ethan、Tina 等（不支持旧的 Chelsie）
QWEN_VOICE=Raymond
# 模型显示名（/api/meta 与自我介绍用，一般无需改动）
AGENT_MODEL_NAME=Qwen3.5-Omni

# --- 豆包 (火山引擎实时语音，experimental；外呼可能不出声) ---
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
# 以下为火山引擎文档给定的固定参数，一般无需改动
DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_APP_KEY=PlgvMymc7f3tQnJ6
AGENT_MODEL_NAME_DOUBAO=Doubao Realtime

# --- OpenAI (Realtime API) ---
OPENAI_API_KEY=
# 实时模型：默认 gpt-realtime-2.1-mini（电话链路延迟优先，建议先用它）。
# 可选：gpt-realtime-2.1-mini | gpt-realtime-2.1 | gpt-realtime-2 | gpt-realtime | gpt-realtime-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# 音色：alloy、ash、cedar、coral、marin 等
OPENAI_VOICE=alloy
# OpenAI 说话 Vibe（仅 OpenAI 链路）：追加在 VOICE_STYLE 之后并入 instructions。
# 空=不追加；可选 calm、cheerful、professional、warm、energetic。参考 https://openai.fm 的 VIBE。
OPENAI_VIBE=
# server_vad 判定「对方说完」的静默窗（毫秒，OpenAI 默认 500）。电话场景调低可
# 明显缩短对方说完→AI 开口的等待；太低会在对方句中停顿时抢话。0=用服务端默认。
OPENAI_VAD_SILENCE_MS=300
# server_vad 能量阈值（0~1，OpenAI 默认 0.5）。电话底噪会拖住判停（真机实测拖
# 0.9~2.7s）；适当抬高判停更利落，太高会漏小声说话。0=用服务端默认。
OPENAI_VAD_THRESHOLD=0
# 输入降噪（喂给 VAD 与模型前）：near_field=近讲耳机，far_field=远场/电话线路。
# 空=不启用。
OPENAI_NOISE_REDUCTION=
# 判停方式：server_vad（只看静音时长，窗短抢话、窗长拖慢）| semantic_vad（按语义
# 判断说完没有，「OK…」稍顿不抢、完整问句立刻接）。semantic_vad 时上面的
# SILENCE_MS/THRESHOLD 不生效。
OPENAI_TURN_DETECTION=server_vad
# semantic_vad 接话积极度：low=多等 | medium | high=尽快接话 | auto=默认。
OPENAI_VAD_EAGERNESS=auto
# 单轮回复 token 上限（0=不限）。提示词不可靠地遵守「说短点」，本地硬切又会把话
# 切在半截；在 provider 侧限长最干净。**audio 与 reasoning token 都计入**：一句话
# ≈ 250，两三句 ≈ 900；设太低会把第一句掐成 incomplete。电话场景建议 900 左右。
OPENAI_MAX_RESPONSE_TOKENS=0
# Realtime 端点覆写（可选，wss 地址 base，留空 = 直连 wss://api.openai.com/v1/realtime）。
# 仅在用反代 / Azure OpenAI，或所在网络无法直连 OpenAI 时才需要填。
OPENAI_REALTIME_URL=
# 模型显示名（/api/meta 用，一般无需改动）
AGENT_MODEL_NAME_OPENAI=OpenAI Realtime

# ================= 模组 =================
# 模组厂商：quectel = EC20/EG25（UAC/QPCMV 音频，默认）；
#          simcom  = SIM7600（AT+CPCMREG PCM-over-USB，须配 MODEM_AUDIO_MODE=nmea，
#                    并用 scripts/sim7600_usb_pty.py 桥把 AT/PCM 接口映射成串口）。
MODEM_VENDOR=quectel
# auto 自动识别；仅打包版 macOS 未设置时默认 auto，源码仍默认 quectel。
# 信号轮询秒数，0 关闭；打包版 macOS 未设置时默认 60。
MODEM_SIGNAL_POLL_SECONDS=0
# Optional Linux-only phone line: MODEM_VENDOR=bluetooth; audio mode/serial ports are ignored.
# Keep the real paired phone address only in local .env (example: 00:11:22:33:44:55).
BLUETOOTH_PHONE_ADDRESS=
# 模组 AT 串口。macOS 必须写 /tmp/ec20-at（由 scripts/ec20_usb_pty.py 桥提供，
# macOS 没有 Quectel 厂商串口的原生设备）；Windows 用 auto 或在设备管理器查看，如 COM3。
# SIM7600(simcom) 用 /tmp/sim7600-at（由 scripts/sim7600_usb_pty.py 桥提供）。
MODEM_PORT=/tmp/ec20-at
# AT 串口波特率（默认: 115200）
MODEM_BAUD=115200
# 音频模式：
#   uac_ffmpeg = macOS 推荐：经 ffmpeg 走 UAC 声卡（PortAudio 打不开 EC20 声卡时用）
#   uac        = USB 声卡（PortAudio/sounddevice；Windows/部分环境可用）
#   nmea       = USB NMEA 串口 PCM【macOS 上会崩溃重枚举 USB，勿用】
MODEM_AUDIO_MODE=uac_ffmpeg
# UAC 声卡名称关键字：macOS UAC 声卡名含 "Interface"；Windows 常为 "EG25"/"EC20"
MODEM_AUDIO_KEYWORD=Interface
# nmea 模式专用 PCM 数据串口与波特率（uac/uac_ffmpeg 模式留空/保持默认即可）
MODEM_PCM_PORT=COM4
MODEM_PCM_BAUD=921600
# 串口 PCM 桥启动即排水，最多保留最近 3 秒上行；真机验收前所有平台默认关闭。
MODEM_PCM_UPLINK_PREBUFFER=false
# 通话结束后查询 AT+CEER，原文写入日志及通话记录；false 完全关闭。
MODEM_LOG_RELEASE_CAUSE=true
# SIM7600 nmea 实验：CPCMREG OK 后先读，首帧下行到达或超时再写；0 保持现状。
MODEM_PCM_UPLINK_HOLD_MS=0
# SIM7600 每通在 CPCMREG 前钉定 8k。未设置时 Linux=true，macOS/Windows=false。
# 保持注释以沿用平台默认值；Pi 配置示例见 scripts/linux/.env.example。
# MODEM_PCM_PIN_8K=false
# SIM7600 每通启用过 PCM 后自动重启（#121）；Linux=true，macOS/Windows=false。
# 保持注释沿用平台默认值；重启期间约 25 秒无法接打电话。
# MODEM_RESET_AFTER_CALL=false
# AI 建连/开场生成与接听及 PCM 准备并行；owner 已决定三平台默认开启。
# 验收闸门为发包前真机验收；显式 false 完全保留串行启动流程。
PARALLEL_AGENT_CONNECT=true
# SIM7600 并行来电：ATA 后由模组先问候，再启用 PCM；Linux 默认 喂，其他平台空。
# 保持注释沿用平台默认值；空字符串关闭，外呼/串行路径不播放。修改后重连生效。
# MODEM_ANSWER_GREETING=
# ATA 返回到发 CTTS 的延迟（毫秒，默认 500）。
# MODEM_ANSWER_GREETING_DELAY_MS=500
# AT+CTTSPARAM 参数；空=不设置。第 2 位由实测的 3 调至 2，音量听感待确认。
# MODEM_TTS_PARAMS=2,2,0,1,1,0
# 上行发送增益（默认: 1.0）
MODEM_TX_GAIN=1.0
# 对方语音送入 AI 模型前的增益（默认: 1.0；录音仍保留原始 PCM）
AGENT_UPLINK_GAIN=1.0
# 模组语音送到远程手机前的增益（默认: 16.0；每通读取，增益后限幅防回绕）
REMOTE_DOWNLINK_GAIN=16.0

# ================= 通话行为 =================
# 半双工挂尾时长（秒，默认: 0.5）
HALF_DUPLEX_HANGOVER_SECONDS=0.5
# AI 调用挂断工具后的延迟挂断秒数（默认: 4.5，留时间说完告别语）
HANGUP_TOOL_DELAY_SECONDS=4.5
# DTMF 发送模式：inband=UAC/uac_ffmpeg 带内双音；qvts=AT+QVTS；both=真机对照双发
# 2026-08-03 真机对照（#74）：一级按键菜单上 inband 4/4、qvts 5/5 均推进，
# 无可测差异，故维持 inband。理由详见 config.py 的 DTMF_MODE 注释。
DTMF_MODE=inband
# 带内双音标定（#73 真机基线：200ms / 0.5 幅度≈-6dBFS；双音自带前后静音隔离带防混叠）
DTMF_TONE_MS=200
# 按键前后静音护窗（毫秒）；0=关闭
DTMF_GUARD_MS=400
DTMF_TONE_AMPLITUDE=0.5
# AI 单轮生成上限（秒，默认: 20；0=不限）。提示词负责压中位数，本闸门只兜长尾。
# WIL-89 基线：单轮中位 6.8s / p90 17.8s / 最长 36.6s——20s 只掐那条 36 秒的。
AGENT_MAX_TURN_SECONDS=20
# 上行纯数字静音累计多久判定媒体已死（秒，默认: 60；0=关闭）。检测总是开着，只落事件。
DEAD_MEDIA_TIMEOUT_SECONDS=60
# 判死后是否真的挂断（默认: false）。精确静音只证明媒体静默、不等于对端挂断，
# 误挂断活着的通话比晚挂断严重得多——先观测攒数据，再决定是否默认开启。
DEAD_MEDIA_HANGUP=false
# AI 下行复读抑制相似度阈值（默认: 0.9；0=关闭）。只比较 AI 自己最近说过的话。
REPEAT_SUPPRESS_SIMILARITY=0.9
# 外呼最长时长（秒，默认: 150）：LLM 收尾裁判失灵时的最后防线，到点自动道别挂断；0=不限
OUTBOUND_MAX_SECONDS=150
# 来电挂断信号与 CLCC 轮询同时失效时的最终兜底（默认 30 分钟）
INBOUND_MAX_SECONDS=1800
# 外呼收尾裁判：接通后首次判断等待与后续判断间隔（隐藏调试项）。
WRAP_UP_JUDGE_GRACE_SECONDS=20.0
WRAP_UP_JUDGE_INTERVAL_SECONDS=15.0
# 仅本卡运营商客服号外呼：将本通收到且经模型判为任务相关的官方短信交给收尾裁判。
# 默认关闭；短信仅作为不可信证据，不直接触发挂机。
WRAP_UP_JUDGE_CARRIER_SMS=false
# 通话录音开关（默认: false；首启向导会要求明确选择）
RECORDING_ENABLED=false
# 录音保留天数（默认: 30）
RECORDING_RETENTION_DAYS=30
# 通话结构化摘要开关（默认: true）
SUMMARY_ENABLED=true
# 摘要使用的文本模型；留空=按提供方自动选择（openai→gpt-4o-mini，qwen→qwen-plus）
SUMMARY_MODEL=
# carrier_sms 结果校验在挂断后等待对应运营商官方短信的最长秒数
SMS_VERIFICATION_WAIT_SECONDS=30

# ================= 本地监听 =================
# 在 Mac 扬声器实时旁听 AI 语音（默认: false）
MONITOR_AI_PLAYBACK=false
# 监听输出设备名（默认空 = 跟随系统默认输出设备；填设备名则按名匹配）
MONITOR_OUTPUT_DEVICE=
# 监听增益：AI 下行（默认: 1.0）；对方上行为窄带低电平信号，需大增益（默认: 8.0）
MONITOR_AI_GAIN=1.0
MONITOR_UPLINK_GAIN=8.0

# ================= 白名单与节流 =================
# 外呼白名单：逗号分隔，支持前缀通配（如 138*,10086）；留空 = 全部放行
DIAL_WHITELIST=
# 连续拨号间隔（秒，默认: 5.0）
DIAL_INTERVAL_SECONDS=5.0
# 短信发送频控（AI 工具与 Web 接口共用，默认每小时 10 条；0=不限）
SMS_RATE_LIMIT_PER_HOUR=10
# 短信目标限制：默认只能回复「已联系过的号码」（来过电/发过短信/已接通外呼）。
# 开发期总开关：置 true 放行发给任意号码（仅本机开发测试用，默认关，勿在生产开启）。
SMS_ALLOW_ANY_TARGET=false
# 收件短信进 app 后删 SIM 上那条，防 SIM 存储满收不到新短信（默认开）
SMS_DELETE_AFTER_INGEST=true
# 收到新短信后转发到邮箱（默认关闭）。开启后短信正文会发送到下面的收件邮箱。
# 公共安装包绝不能内置共享 SMTP 密码；每个部署须填写自己的发件账号/应用密码。
SMS_EMAIL_FORWARD_ENABLED=false
SMS_EMAIL_RECIPIENT=
# SMTP 仅允许加密连接：starttls（常用端口 587）或 ssl（常用端口 465）。
SMS_EMAIL_SMTP_HOST=
SMS_EMAIL_SMTP_PORT=587
SMS_EMAIL_SMTP_SECURITY=starttls
SMS_EMAIL_SMTP_USERNAME=
SMS_EMAIL_SMTP_PASSWORD=
SMS_EMAIL_FROM=
# 是否向模型注册「查询最近短信验证码」工具（默认 true；关闭后模型看不到该工具）
TOOL_QUERY_CODE_ENABLED=true
# 发短信目标限制为「只能回复已联系过的号码」（来过电/发过短信/当前通话对端），
# 无需配置，见 src/agentcall/contacts.py。

# 来电 AI 判断后转到已配对手机真人接管。默认关闭；偏好是机主自由文本，不写死类别。
# 仅蓝牙手机线路：off / allowlist / unanswered；默认不接听，不影响串口模组。
# 本策略优先于 INBOUND_TRIAGE_MODE；蓝牙线路不支持转真人到 App。
INBOUND_AI_ANSWER_MODE=off
# 逗号分隔号码，仅本地 .env 存放；隐藏号码不匹配；支持 +86 / 0086 归一化。
INBOUND_AI_ALLOWLIST=
# 1..600 秒，默认 15；应早于运营商无应答转移/语音信箱（常见 20-30 秒）。
INBOUND_AI_ANSWER_AFTER_SECONDS=15
INBOUND_TAKEOVER_ENABLED=false
# Seconds from takeover request to mobile media commit; invalid/non-positive values fall back to 20.
INBOUND_TAKEOVER_TIMEOUT_SECONDS=20
# 机主确认环（WIL-120 二期）：外呼中 AI 遇到超预授权的方案时推 Web 确认卡，
# 等这么多秒；超时=拒绝（机主没看到不等于同意）
OWNER_CONFIRM_TIMEOUT_SECONDS=60
# Mac 打包版系统通知；这里只控制发送，不触发系统授权。修改后立即生效。
MAC_NOTIFICATIONS_ENABLED=true
MAC_NOTIFY_CONFIRM=true
MAC_NOTIFY_INFO=true
MAC_NOTIFY_ALERT=true
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_URL=https://api-beta.bondings.ai/v1/releases/latest?product=physical-sim&platform=macos
# wait_for_sms 工具等新短信（OTP/确认短信）的窗口秒数（WIL-120 三期）
WAIT_SMS_TIMEOUT_SECONDS=60
# Path B「我来说」三方并入时拨给机主的第二号码（WIL-120 四期）；
# 留空 = 确认卡「我来说」按钮置灰
OWNER_SECOND_PHONE=
# 对话建单模型：留空 = provider 强档默认（openai 用 gpt-4o——便宜档 4o-mini
# 实测追问质量差、JSON 纪律不稳）
INTAKE_MODEL=
INBOUND_TAKEOVER_PREFERENCE=
# 来电分诊判官：off=关闭，shadow=只记录，enforce=执行拒绝/转接。生产默认关闭。
INBOUND_TRIAGE_MODE=off

# ================= 远程网页拨号 POC =================
# 默认关闭。拨号页通过 LiveKit 数据/媒体通道控制 Edge，不需要把本地管理端口暴露到公网。
REMOTE_WEB_DIALER_ENABLED=false
# 普通 Beta 用户启用公司托管控制面：无需 Cloudflare Tunnel 或本地 LiveKit 密钥。
REMOTE_CLOUD_ENABLED=false
# 已授权手机只读同步短信与规范化通话记录；Cloud 侧还须独立授权，默认关闭。
REMOTE_CONTENT_READ_ENABLED=false
REMOTE_CLOUD_URL=https://api-beta.bondings.ai
REMOTE_MEDIA_PROVIDER=livekit
# 远程真人拨号默认用模组 QVTS；both 同时发送 QVTS 与带内双音。
REMOTE_DTMF_MODE=qvts
# 真人远程通话默认不录音；明确开启后录音也只保存在 Edge 本地。
REMOTE_HUMAN_RECORDING_ENABLED=false
# 仅本地 Tunnel 调试模式使用以下四项；云控制面模式由服务端签发短期媒体凭证。
REMOTE_CONTROL_URL=https://dial.example.com/remote_dialer.html
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 手机媒体中断超过该秒数后，Edge 自动挂断真实电话。
REMOTE_DISCONNECT_GRACE_SECONDS=5
REMOTE_OUTBOUND_MAX_SECONDS=1800
REMOTE_DIAL_LIMIT_PER_HOUR=10
# Cloudflare Tunnel 只转发到这个独立的最小权限网关，绝不能转发 WEB_PORT。
REMOTE_GATEWAY_PORT=47445
# 配对码有效期与最多配对设备数（内部安全默认值）。
REMOTE_PAIRING_TTL_SECONDS=300
REMOTE_MAX_PAIRED_DEVICES=5
# 单通邀请有效期（隐藏项，允许范围 30-900 秒）。
REMOTE_INVITE_TTL_SECONDS=300
REMOTE_CONNECT_TIMEOUT_SECONDS=45

# ================= 连接管理 =================
# Qwen 连接预热：提前建好 TLS 连接，降低首通接听延迟（默认: true）
QWEN_PREWARM=true
# 通话中断线的最大重连次数（默认: 2）
QWEN_RECONNECT_MAX=2
# OpenAI 通话中断线的最大重连次数（默认: 2）
OPENAI_RECONNECT_MAX=2

# ================= Web 启动 =================
# 源码入口默认打开浏览器；Linux systemd 服务强制为 false。
WEB_OPEN_BROWSER=true
