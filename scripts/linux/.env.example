# Linux / Raspberry Pi + SIM7600 overrides. Merge into the repo's .env;
# do not replace an existing .env or copy these values to other platforms.
AGENT_PROVIDER=local
LOCAL_LLM_PROVIDER=deepseek
LOCAL_LLM_MODEL=deepseek-flash
MODEM_VENDOR=simcom
MODEM_PORT=/dev/callpilot-sim7600-at
MODEM_AUDIO_MODE=nmea
MODEM_PCM_PORT=/dev/callpilot-sim7600-pcm
MODEM_PCM_BAUD=115200
MODEM_PCM_UPLINK_PREBUFFER=false
# 通话结束后查询 AT+CEER，原文写入日志及通话记录；false 完全关闭。
MODEM_LOG_RELEASE_CAUSE=true
MODEM_PCM_PIN_8K=true
MODEM_RESET_AFTER_CALL=true
# owner 决定默认并行；发包前必须完成真机验收。
PARALLEL_AGENT_CONNECT=true
# 本地三段式慢网兜底；0 关闭，短句自动预合成。
LOCAL_SLOW_REPLY_FILLER_SECONDS=2.5
LOCAL_SLOW_REPLY_FILLER=嗯。
WRAP_UP_JUDGE_CARRIER_SMS=false
MODEM_ANSWER_GREETING=喂
MODEM_ANSWER_GREETING_DELAY_MS=500
MODEM_TTS_PARAMS=2,2,0,1,1,0
WEB_OPEN_BROWSER=false
WEB_HOST=127.0.0.1
WEB_PORT=47100
# 仅 Mac 打包版发送系统通知；Linux 仍提供通知事件接口。
MAC_NOTIFICATIONS_ENABLED=true
MAC_NOTIFY_CONFIRM=true
MAC_NOTIFY_INFO=true
MAC_NOTIFY_ALERT=true
## Optional phone line (keep real address in local .env only):
# MODEM_VENDOR=bluetooth
# BLUETOOTH_PHONE_ADDRESS=00:11:22:33:44:55
