{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Physical-SIM line's own relay (pairing, remote dial, content read, LiveKit media).
  // Same code as the shared Beta Worker, separate Worker / D1 / Durable Objects.
  // Always pass -c wrangler.sim-relay.jsonc; bare `wrangler deploy` targets the shared Worker.
  "name": "callpilot-sim-relay",
  "main": "src/index.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "sim-relay.bondings.ai", "custom_domain": true }
  ],
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  // D1 与 EdgeRoom DO 在 SIN；中国大陆手机请求经 Cloudflare 落在 LAX，默认在 LAX 执行时每次 D1/DO 往返 ~190 ms，
  // 建呼叫要 4–5 次。指定在新加坡执行：入口到 SIN 只跨洋一次，D1/DO 变为本地往返（11-05 实测定位）。
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "callpilot-sim-relay",
      "database_id": "cbfc9a37-5a05-4550-a4be-832a854e388c",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "EDGE_ROOMS", "class_name": "EdgeRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EdgeRoom"] }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://sim-relay.bondings.ai",
    "ALERT_PUSH_ENABLED": "false"
  }
}
