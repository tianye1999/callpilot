{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "callpilot-direct-local-test",
  "main": "direct-integration-worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": false },
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "callpilot-direct-local-test",
    "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "../migrations" }],
  "durable_objects": { "bindings": [{ "name": "EDGE_ROOMS", "class_name": "EdgeRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EdgeRoom"] }],
  "vars": {
    "PUBLIC_ORIGIN": "https://direct.test",
    "ADMIN_TOKEN": "synthetic-local-admin-token-not-a-secret",
    "LIVEKIT_URL": "wss://media.invalid",
    "LIVEKIT_API_KEY": "synthetic-key",
    "LIVEKIT_API_SECRET": "synthetic-local-livekit-signing-key-not-a-secret",
    "INBOUND_FASTPATH_V2_ENABLED": "true",
    "TURN_KEY_ID": "synthetic-direct-key",
    "TURN_API_TOKEN": "synthetic-local-turn-token-not-a-secret"
  }
}
